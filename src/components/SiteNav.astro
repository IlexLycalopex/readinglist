---
import type { YearMeta } from '../lib/data';

interface Props {
  years: YearMeta[];
  currentPath: string;
}

const { years, currentPath } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<nav class="site-nav">
  <div class="container site-nav__inner">

    <!-- Logo -->
    <a href={`${base}/`} class="site-nav__logo">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
      </svg>
      <span>Reading Log</span>
    </a>

    <!-- Right-side links -->
    <div class="site-nav__links">

      <!-- Year pills -->
      {years.map((y) => (
        <a
          href={`${base}/${y.id}/`}
          class={`site-nav__pill${currentPath.includes(`/${y.id}/`) ? ' active' : ''}`}
        >
          {y.id}
        </a>
      ))}

      <span class="site-nav__sep"></span>

      <!-- Section links -->
      <a
        href={`${base}/authors/`}
        class={`site-nav__pill${currentPath.includes('/authors') ? ' active' : ''}`}
      >
        Authors
      </a>
      <a
        href={`${base}/publishers/`}
        class={`site-nav__pill${currentPath.includes('/publishers') ? ' active' : ''}`}
      >
        Publishers
      </a>
      <a
        href={`${base}/dashboard/`}
        class={`site-nav__pill${currentPath.includes('/dashboard') ? ' active' : ''}`}
      >
        Dashboard
      </a>

    </div>
  </div>
</nav>
