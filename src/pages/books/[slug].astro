---
import Base from '../../layouts/Base.astro';
import { loadAllBooks } from '../../lib/data';
import type { Book } from '../../lib/data';

export async function getStaticPaths() {
  const books = loadAllBooks();
  return books.map((book) => ({
    params: { slug: book.id },
    props: { book },
  }));
}

interface Props { book: Book; }
const { book } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formatColor: Record<string, string> = {
  print: 'var(--accent)',
  audio: 'var(--accent-audio)',
  graphic: 'var(--accent-graphic)',
};
const color = formatColor[book.format] ?? 'var(--accent)';
const formatLabel: Record<string, string> = { print: 'Print', audio: 'Audiobook', graphic: 'Graphic Novel' };

function fmt(d: string | null) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
---
<Base
  title={`${book.title} — Reading Log`}
  description={book.description ?? `${book.title} by ${book.author}`}
>
  <div class="book-detail">

    <a href={`${base}/${book.year_read}/`} class="book-detail__back">
      <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M10 3L5 8l5 5"/>
      </svg>
      {book.year_read}
    </a>

    <div class="book-detail__layout">

      <!-- Cover -->
      <div>
        {book.cover_url ? (
          <img
            class="book-detail__cover"
            src={book.cover_url}
            alt={`Cover of ${book.title}`}
            width="220"
            height="330"
          />
        ) : (
          <div class="book-detail__cover-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" width="60" height="60">
              <path d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
            </svg>
          </div>
        )}
      </div>

      <!-- Info -->
      <div>
        <div class="book-detail__format-badge" style={`color: ${color}`}>
          {book.format === 'audio' && (
            <svg viewBox="0 0 20 20" fill="currentColor" width="13" height="13"><path d="M9 3a1 1 0 0 0-1.414 0L3.172 7.414A4 4 0 0 0 2 10.172V15a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-4.828a4 4 0 0 0-1.172-2.758L10.414 3A1 1 0 0 0 9 3z"/></svg>
          )}
          {book.format === 'graphic' && (
            <svg viewBox="0 0 20 20" fill="currentColor" width="13" height="13"><rect x="2" y="2" width="7" height="9" rx="1"/><rect x="11" y="2" width="7" height="5" rx="1"/><rect x="11" y="9" width="7" height="9" rx="1"/><rect x="2" y="13" width="7" height="5" rx="1"/></svg>
          )}
          {formatLabel[book.format]}
        </div>

        <h1 class="book-detail__title">{book.title}</h1>
        <p class="book-detail__author">{book.author}</p>

        <div class="book-detail__meta">
          {book.year_published && <span class="book-detail__meta-chip">{book.year_published}</span>}
          {book.pages && <span class="book-detail__meta-chip">{book.pages} pages</span>}
          {book.publisher && <span class="book-detail__meta-chip">{book.publisher}</span>}
          {book.genre && <span class="book-detail__meta-chip">{book.genre}</span>}
          {book.isbn && <span class="book-detail__meta-chip" title="ISBN">ISBN {book.isbn}</span>}
          <span class="book-detail__meta-chip">Read in {book.year_read}</span>
          {book.date_started && book.date_finished && (
            <span class="book-detail__meta-chip">{fmt(book.date_started)} – {fmt(book.date_finished)}</span>
          )}
          {!book.date_started && book.date_finished && (
            <span class="book-detail__meta-chip">Finished {fmt(book.date_finished)}</span>
          )}
        </div>

        {book.tags.length > 0 && (
          <div class="book-card__tags" style="margin-bottom: 1.5rem">
            {book.tags.map((tag) => <span class="book-card__tag">{tag}</span>)}
          </div>
        )}

        {book.description && (
          <p class="book-detail__description">{book.description}</p>
        )}

        {book.notes && (
          <blockquote class="book-detail__notes">{book.notes}</blockquote>
        )}

        <div class="book-detail__links">
          {book.links.openlibrary && (
            <a href={book.links.openlibrary} target="_blank" rel="noopener" class="book-detail__link">
              <svg viewBox="0 0 20 20" fill="currentColor" width="13" height="13"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd"/></svg>
              Open Library
            </a>
          )}
          {book.links.wikipedia && (
            <a href={book.links.wikipedia} target="_blank" rel="noopener" class="book-detail__link">
              <svg viewBox="0 0 20 20" fill="currentColor" width="13" height="13"><path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd"/></svg>
              Wikipedia
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</Base>
