---
import Base from '../../layouts/Base.astro';
import { loadAllBooks, getAllAuthors } from '../../lib/data';

export async function getStaticPaths() {
  const books = loadAllBooks();
  const authors = getAllAuthors(books);
  return authors.map((a) => ({
    params: { slug: a.slug },
    props: { author: a },
  }));
}

const { author } = Astro.props;

const sortedBooks = [...author.books].sort((a, b) => {
  if (a.year_read !== b.year_read) return a.year_read - b.year_read;
  return a.order_read - b.order_read;
});

const formatLabels: Record<string, string> = { print: 'Print', audio: 'Audio', graphic: 'Graphic' };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${author.name} — Reading Log`} description={`Books by ${author.name} in the reading log.`}>
  <div class="page-header">
    <h1>{author.name}</h1>
    <p class="subtitle">
      {author.bookCount} {author.bookCount === 1 ? 'book' : 'books'} ·
      {[...author.years].sort((a, b) => a - b).join(', ')}
    </p>
    <div class="format-dots">
      {Array.from(author.formats).map((fmt) => (
        <span class="format-tag" data-format={fmt}>{formatLabels[fmt]}</span>
      ))}
    </div>
  </div>

  <div class="books-list">
    {sortedBooks.map((book) => (
      <div class="book-row">
        <div class="book-row__thumb">
          {book.cover_url ? (
            <img src={book.cover_url} alt={book.title} loading="lazy" />
          ) : (
            <div class="cover-placeholder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
              </svg>
            </div>
          )}
        </div>
        <div class="book-row__info">
          <p class="book-row__title">{book.title}</p>
          <p class="book-row__meta">
            {book.year_published ? `${book.year_published} · ` : ''}
            <span class={`format-inline format-inline--${book.format}`}>{formatLabels[book.format]}</span>
            {` · `}
            <a href={`${base}/${book.year_read}/`}>{book.year_read}</a>
            {book.date_finished ? ` · Finished ${book.date_finished}` : ''}
          </p>
        </div>
      </div>
    ))}
  </div>
</Base>

<style>
  .format-dots { display: flex; gap: 0.5rem; margin-top: 0.75rem; flex-wrap: wrap; }

  .format-tag {
    font-size: 0.8rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .format-tag[data-format="print"]   { border-color: var(--accent); color: var(--accent); }
  .format-tag[data-format="audio"]   { border-color: var(--accent-audio); color: var(--accent-audio); }
  .format-tag[data-format="graphic"] { border-color: var(--accent-graphic); color: var(--accent-graphic); }

  .format-inline--print   { color: var(--accent); }
  .format-inline--audio   { color: var(--accent-audio); }
  .format-inline--graphic { color: var(--accent-graphic); }

  .books-list { padding: 1rem 0; }
</style>
