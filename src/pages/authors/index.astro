---
import Base from '../../layouts/Base.astro';
import GroupCard from '../../components/GroupCard.astro';
import { loadAllBooks, getAllAuthors } from '../../lib/data';

const books = loadAllBooks();
const authors = getAllAuthors(books);
---
<Base title="Authors — Reading Log" description="All authors in the reading history.">
  <div class="page-header">
    <h1>Authors</h1>
    <p class="subtitle">{authors.length} authors across all years — select one to see the books</p>
  </div>

  <div class="author-grid">
    {authors.map((author) => (
      <GroupCard name={author.name} books={author.books} formats={author.formats} years={author.years} />
    ))}
  </div>
</Base>
