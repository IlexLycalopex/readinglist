---
import type { PublisherSummary } from '../lib/data';

interface Props {
  publisher: PublisherSummary;
}

const { publisher } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sortedYears = [...publisher.years].sort((a, b) => a - b);
---
<a class="author-card" href={`${base}/publishers/${publisher.slug}/`}>
  <p class="author-card__name">{publisher.name}</p>
  <p class="author-card__count">{publisher.bookCount} {publisher.bookCount === 1 ? 'book' : 'books'}</p>
  <div class="author-card__dots">
    {Array.from(publisher.formats).map((fmt) => (
      <span class={`format-pip format-pip--${fmt}`} title={fmt}></span>
    ))}
  </div>
  <p class="author-card__years">{sortedYears.join(', ')}</p>
</a>
