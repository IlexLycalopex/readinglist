---
import Base from '../../layouts/Base.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import { loadAllBooks, getAllAuthors } from '../../lib/data';

const books = loadAllBooks();
const authors = getAllAuthors(books);
---
<Base title="Authors — Reading Log" description="All authors in the reading history.">
  <div class="page-header">
    <h1>Authors</h1>
    <p class="subtitle">{authors.length} authors across all years</p>
  </div>

  <div class="author-grid">
    {authors.map((author) => <AuthorCard author={author} />)}
  </div>
</Base>
